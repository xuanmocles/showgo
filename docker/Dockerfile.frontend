# ============================================================
# 星幕票务 ShowGo —— 前端镜像
# Vite 构建静态资源，运行时由 Nginx 托管并反向代理 /api 到后端
# ============================================================
FROM node:22-alpine AS build

WORKDIR /app

# 先装依赖，利用镜像层缓存：只要 lock 文件不变就不会重复下载
COPY showgo-vue3/package.json showgo-vue3/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY showgo-vue3/ ./
RUN npm run build

# ------------------------------------------------------------
FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
